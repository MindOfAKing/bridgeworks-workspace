{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bridgeworks://internal-gtm/qualification-v1",
  "title": "BridgeWorks qualification-v1 result",
  "type": "object",
  "required": [
    "qualification_version", "score", "max_score", "tier", "actionability",
    "blocking_reasons", "components", "adjustments", "thresholds", "qualification_coverage"
  ],
  "properties": {
    "qualification_version": {"const": "qualification-v1"},
    "model": {"const": "qualification-v1"},
    "model_approved": {"type": "string"},
    "as_of": {"type": "string"},
    "derived_by": {"type": "string"},
    "score": {"type": "integer", "minimum": 0, "maximum": 100},
    "max_score": {"const": 100},
    "tier": {"enum": ["HOT", "STRONG", "QUALIFIED", "WATCH", "DO_NOT_PURSUE"]},
    "actionability": {
      "enum": [
        "actionable", "blocked_unresolved_identity_domain", "blocked_missing_destination",
        "blocked_contradicted_evidence", "blocked_unresolved_communication_state",
        "blocked_legal_compliance", "blocked_no_service_route", "blocked_defer_hold",
        "blocked_unverified_gate_state"
      ]
    },
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "blocking_conditions": {"type": "array", "items": {"type": "object"}},
    "components": {
      "type": "object",
      "required": [
        "problem_evidence", "commercial_fit", "buyer_accessibility",
        "trigger_urgency", "proof_fit", "execution_readiness"
      ],
      "properties": {
        "problem_evidence": {"$ref": "#/$defs/component25"},
        "commercial_fit": {"$ref": "#/$defs/component20"},
        "buyer_accessibility": {"$ref": "#/$defs/component15"},
        "trigger_urgency": {"$ref": "#/$defs/component15"},
        "proof_fit": {"$ref": "#/$defs/component15"},
        "execution_readiness": {"$ref": "#/$defs/component10"}
      },
      "additionalProperties": false
    },
    "adjustments": {"type": "array", "items": {"type": "object"}},
    "thresholds": {"type": "object"},
    "gates_evaluated": {"type": "object"},
    "component_scores": {"type": "object"},
    "unscored_components": {"type": "array", "items": {"type": "string"}},
    "unresolvable_evidence_ids": {"type": "array", "items": {"type": "string"}},
    "evidence_gap": {"type": "boolean"},
    "qualification_coverage": {
      "type": "object",
      "required": ["sufficiently_researched_dimensions", "total_dimensions", "percentage", "by_dimension"],
      "properties": {
        "sufficiently_researched_dimensions": {"type": "integer", "minimum": 0, "maximum": 6},
        "total_dimensions": {"const": 6},
        "percentage": {"type": "number", "minimum": 0, "maximum": 100},
        "by_dimension": {"type": "object"}
      }
    },
    "superseded_reference": {"type": "object"}
  },
  "$defs": {
    "componentBase": {
      "type": "object",
      "required": [
        "score", "requested_score", "max_score", "evidence_ids", "usable_evidence_ids",
        "contradicted_evidence_ids", "evidence_freshness", "confidence",
        "source_provenance", "adjustment_reason", "evidence_state", "research_status"
      ],
      "properties": {
        "score": {"type": "integer", "minimum": 0},
        "requested_score": {"type": "integer", "minimum": 0},
        "max_score": {"type": "integer"},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "usable_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "contradicted_evidence_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_freshness": {"enum": ["current", "stale", "unknown"]},
        "confidence": {"enum": ["unknown", "low", "medium", "high"]},
        "source_provenance": {"type": "array", "items": {"type": "string"}},
        "adjustment_reason": {"type": ["string", "null"]},
        "evidence_state": {"enum": ["approved", "stale", "contradicted", "unknown", "not_applicable"]},
        "research_status": {"enum": ["complete", "partial", "required", "exhausted_unknown", "not_applicable"]}
      }
    },
    "component25": {"allOf": [{"$ref": "#/$defs/componentBase"}, {"properties": {"score": {"maximum": 25}, "requested_score": {"maximum": 25}, "max_score": {"const": 25}}}]},
    "component20": {"allOf": [{"$ref": "#/$defs/componentBase"}, {"properties": {"score": {"maximum": 20}, "requested_score": {"maximum": 20}, "max_score": {"const": 20}}}]},
    "component15": {"allOf": [{"$ref": "#/$defs/componentBase"}, {"properties": {"score": {"maximum": 15}, "requested_score": {"maximum": 15}, "max_score": {"const": 15}}}]},
    "component10": {"allOf": [{"$ref": "#/$defs/componentBase"}, {"properties": {"score": {"maximum": 10}, "requested_score": {"maximum": 10}, "max_score": {"const": 10}}}]}
  },
  "additionalProperties": false
}
