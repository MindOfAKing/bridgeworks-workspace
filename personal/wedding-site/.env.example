# Wedding site environment variables.
# Copy to .env.local for local work. Never commit real values.

# The shared passphrase printed on the invitations.
SITE_PASSWORD=

# Any long random string. Used to hash the unlock cookie so the passphrase
# itself is never stored in the browser. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend, for RSVP notification emails. https://resend.com
RESEND_API_KEY=
# The family inbox that receives every RSVP.
RSVP_TO=
# Verified sender. Until a domain is verified in Resend, use the onboarding sender.
RSVP_FROM=Wedding Website <onboarding@resend.dev>

# Supabase, for the stored guest list. Server only, never exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Guest photo drop. Uploads land in a folder in the couple's Drive.
# Run `node scripts/google-drive-setup.mjs --client-id ... --client-secret ...`
# once to produce the refresh token and the folder id.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_UPLOAD_FOLDER_ID=

# The deployed origin, e.g. https://floraandemmanuel.com. Google needs it to
# return an upload session the browser is allowed to send to. Falls back to the
# request origin when unset.
NEXT_PUBLIC_SITE_ORIGIN=

# Preview only. Set to 1 to render the site with invented sample content and a
# preview ribbon, for judging the design. Never set this on a live deploy.
NEXT_PUBLIC_PREVIEW_SAMPLE=
