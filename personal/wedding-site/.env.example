# Wedding site environment variables.
# Copy to .env.local for local work. Never commit real values.

# The shared passphrase printed on the invitations.
SITE_PASSWORD=

# Any long random string. Used to hash the unlock cookie so the passphrase
# itself is never stored in the browser. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Resend, for RSVP notification emails. https://resend.com
RESEND_API_KEY=
# The family inbox that receives every RSVP.
RSVP_TO=
# Verified sender. Until a domain is verified in Resend, use the onboarding sender.
RSVP_FROM=Wedding Website <onboarding@resend.dev>

# Supabase, for the stored guest list. Server only, never exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
